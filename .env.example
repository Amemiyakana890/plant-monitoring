PORT=3000

# server/ から `node app.js` (または `npm start`) を実行する前提の相対パス。
# 既存のDBファイルをそのまま使う場合は "plant_monitoring.db" のままにすること。
DB_PATH=plant_monitoring.db

API_BASE_URL=http://localhost:3000

# ESP32から/api/sensorへ送信するための秘密キー。
# 既存データの所有者移行時のみ旧デバイスキーのハッシュ化に使う。
# 新規デバイスにはアプリのペアリング時に個別キーが発行される。
DEVICE_API_KEY=replace-with-a-long-random-device-key
LEGACY_DEVICE_ID=1

# 既存DBをユーザー分離へ移行する際に、旧データを引き継ぐFirebase UIDを一度指定する。
# 既存データの移行完了後、この値は削除してよい。
LEGACY_DATA_OWNER_UID=

# Firebase Admin SDKサービスアカウントJSONの絶対パス
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\plant-mimamori-firebase-adminsdk.json
