// secrets.h.example
//
// Wi-Fi情報・サーバーIPのテンプレート。
// 実際の値を入れた secrets.h は .gitignore で管理対象外にしているため、
// このファイルをコピーして作成すること。
//
//   cp secrets.h.example secrets.h    (Mac/Linux)
//   copy secrets.h.example secrets.h  (Windows)
//
// secrets.h 自体はGitにコミットしないこと(パスワードが含まれるため)。

#ifndef PLANT_MONITORING_SECRETS_H
#define PLANT_MONITORING_SECRETS_H

// 2.4GHz帯のSSIDを指定すること(ATOM Matrixは5GHz非対応)
const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// サーバー(Node.js)を動かしているPCのLAN IP。
// PowerShellで `ipconfig` を実行し、Wi-FiアダプターのIPv4アドレスを確認する。
// app/lib/config/api_config.dart の baseUrl と同じホストにすること。
const char* SERVER_HOST = "192.168.1.10";

// server/.envのDEVICE_API_KEYと同じ値を設定すること。
const char* DEVICE_API_KEY = "YOUR_DEVICE_API_KEY";

#endif
